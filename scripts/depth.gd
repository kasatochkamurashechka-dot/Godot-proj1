class_name Depth
## «Глубина» в духе Hotline Miami: под героем, врагами, мебелью и оружием рисуется тень,
## сдвинутая вправо-вниз. Кажется, что всё стоит над полом, а свет падает сверху-слева.
## Использование в _draw любого узла:
##     draw_circle(Depth.offset(self), радиус, Depth.COLOR)

const OFFSET := Vector2(3, 4)          # куда падает тень (в пикселях экрана)
const COLOR := Color(0, 0, 0, 0.35)


## Сдвиг тени в координатах узла. Узел может быть повёрнут (герой смотрит на курсор),
## поэтому сдвиг «отворачиваем» обратно — тень всегда падает в одну сторону.
static func offset(node: Node2D) -> Vector2:
	return OFFSET.rotated(-node.global_rotation)
